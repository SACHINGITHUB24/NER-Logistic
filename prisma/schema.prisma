generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())
}

model Road {
  id               String   @id @default(cuid())
  name             String
  fromDistrict     String
  toDistrict       String
  riskScore        Int      @default(0)
  status           Status   @default(CLEAR)
  alternateRouteId String?
  reroutingActive  Boolean  @default(false)
  geometry         Json
  reports          Report[]
  alerts           Alert[]
}

model District {
  id                  String  @id @default(cuid())
  name                String
  lat                 Float
  lng                 Float
  supplyDaysRemaining Float   @default(30)
  drainRate           Float   @default(1)
  daysToStockout      Float   @default(30)
  primaryRoadId       String
  alerts              Alert[]
}

// model Report {
//   id          String        @id @default(cuid())
//   roadId      String
