// }

model Report {
  id          String        @id @default(cuid())
  roadId      String
  severity    Severity
  description String
  imageUrl    String?
  status      ReportStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  road        Road          @relation(fields: [roadId], references: [id])
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model Alert {
  id         String   @id @default(cuid())
  roadId     String
  districtId String
  message    String
  createdAt  DateTime @default(now())
  road       Road     @relation(fields: [roadId], references: [id])
  district   District @relation(fields: [districtId], references: [id])
}

enum Role {
  CITIZEN
  OFFICIAL
}

enum Status {
  CLEAR
  AT_RISK
  BLOCKED
}

enum Severity {
  MINOR
  MAJOR
  BLOCKED
}