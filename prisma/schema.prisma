generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(CITIZEN)
  createdAt DateTime @default(now())
  name      String?
  reports   Report[]
}

model Road {
  id               String   @id @default(cuid())
  name             String
  fromDistrict     String
  toDistrict       String
  riskScore        Int      @default(0)
  status           Status   @default(CLEAR)
  alternateRouteId String?
  reroutingActive  Boolean  @default(false)
  geometry         Json
  alerts           Alert[]
  reports          Report[]
}

model District {
  id                  String  @id @default(cuid())
  name                String
  lat                 Float
  lng                 Float
  supplyDaysRemaining Float   @default(30)
  drainRate           Float   @default(1)
  daysToStockout      Float   @default(30)
  primaryRoadId       String
  alerts              Alert[]
}

model Report {
  id          String       @id @default(cuid())
  roadId      String
  severity    Severity
  description String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  imageUrl    String?
  userId      String?
  road        Road         @relation(fields: [roadId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
}

model Alert {
  id         String   @id @default(cuid())
  roadId     String
  districtId String
  message    String
  createdAt  DateTime @default(now())
  district   District @relation(fields: [districtId], references: [id])
  road       Road     @relation(fields: [roadId], references: [id])
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  CITIZEN
  OFFICIAL
}

enum Status {
  CLEAR
  AT_RISK
  BLOCKED
}

enum Severity {
  MINOR
  MAJOR
  BLOCKED
}
